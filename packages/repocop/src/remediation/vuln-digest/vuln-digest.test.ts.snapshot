exports[`createDigestForSeverity > matches the full digest message snapshot for a representative scenario 1`] = `
"Found 3 high vulnerabilities introduced in the last 60 days. Teams have 30 days to fix these.\\nNote: DevX only aggregates vulnerability information for runtime dependencies in repositories with a production topic.\\n\\n[repo](https://github.com/guardian/repo) contains 2 high severity vulnerabilities with a patch, CVE-100, CVE-200, from [leftpad](example.com), introduced via pip. There are 25 days left to resolve the earliest alert.\\n\\n[repo](https://github.com/guardian/repo) contains a high severity vulnerability without a patch, CVE-300, from [rightpad](example.com), introduced via pip. There are 28 days left to resolve the alert."
`;

exports[`createMalwareDigest > matches the full digest message snapshot for a representative scenario 1`] = `
"Found 2 malware alerts introduced in the last 60 days. Please address within 1 working day.\\nNote: Malware information provided is only for repositories with a production topic. Currently the only ecosystem supported by Dependabot is npm.\\n\\n[repo](https://github.com/guardian/repo) contains malware with a patch, CVE-M1, CVE-M2, from [bad-package](example.com). There are 1 days left to resolve the earliest alert."
`;
